# Server-side only, never NEXT_PUBLIC_.

# Backend base URL, including /v1.
API_BASE_URL=http://localhost:8080/v1
# The shop's public origin (scheme://host[:port]). Mutating route handlers accept this Origin only; unset or malformed
# = all refused. In production it must be the https public origin (e.g. https://jomhor.ma), never http.
SHOP_ORIGIN=http://localhost:3000
# The backend's public base URL (its PUBLIC_BASE_URL), including /v1. The card payment redirect is followed only when
# it is {API_PUBLIC_URL}/payments/card/{payment_id}/redirect on that exact origin; unset or malformed = payments refused.
API_PUBLIC_URL=http://localhost:8080/v1
# Proxies in front of the shop that append to X-Forwarded-For (default 1 = the ALB). The fan's IP is the entry at
# index length - hops; 0 = forward no client IP (the backend then counts the shop's own address).
# Only safe when the shop is reachable solely through those proxies (security group admits the ALB only, ALB XFF
# mode "append"); otherwise a client can forge the entry the shop trusts.
TRUSTED_PROXY_HOPS=1
