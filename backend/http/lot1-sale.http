### Lot 1 demo: sell 2 named tickets by card on the simulated gateway, the 2nd held by a friend (IntelliJ HTTP client).
#
# Start the backend with the dev profile (dev seed: ATLAS FC, admin +212600000001, Grand Stade):
#   docker compose up -d && SPRING_PROFILES_ACTIVE=dev ./gradlew bootRun
# Run the requests top to bottom. OTP codes are printed by the dev log sender: look in the backend log for
#   [dev OTP] +2126... -> 123456
# and paste them into @orgCode / @fanCode before running the matching verify request.
# The event can come from the back-office (B2) instead: then skip steps 3-5 and set eventId/priceId from step 3b.

@base = http://localhost:8080/v1
@org = a7a5fc00-0000-4000-8000-000000000001
@venue = a7a5fc00-0000-4000-8000-000000000301
@adminPhone = +212600000001
@fanPhone = +212611111111
@friendPhone = +212622222222
@orgCode = 000000
@fanCode = 000000

### 1. Organizer: ask for a code (read it in the backend log, put it in @orgCode)
POST {{base}}/org/auth/otp
Content-Type: application/json

{"phone": "{{adminPhone}}"}

### 2. Organizer: verify
POST {{base}}/org/auth/verify
Content-Type: application/json

{"phone": "{{adminPhone}}", "code": "{{orgCode}}"}

> {% client.global.set("orgToken", response.body.token); %}

### 3. Organizer: the Grand Stade zones (keeps the first zone id)
GET {{base}}/org/venues/{{venue}}
Authorization: Bearer {{orgToken}}
X-Organizer-Id: {{org}}

> {% client.global.set("zoneId", response.body.zones[0].id); %}

### 3b. (event made in the back-office) list events, then set eventId / priceId from the responses
GET {{base}}/org/events?status=ON_SALE
Authorization: Bearer {{orgToken}}
X-Organizer-Id: {{org}}

### 4. Organizer: a DRAFT match
POST {{base}}/org/events
Authorization: Bearer {{orgToken}}
X-Organizer-Id: {{org}}
Content-Type: application/json

{"venue_id": "{{venue}}", "event_type": "FOOTBALL_MATCH", "title": "ATLAS FC – Démo Lot 1",
 "starts_at": "2099-05-01T19:00:00Z", "metadata": {"opponent": "Démo"}}

> {% client.global.set("eventId", response.body.id); %}

### 5a. Organizer: a price (50 DH, 100 places)
POST {{base}}/org/events/{{eventId}}/prices
Authorization: Bearer {{orgToken}}
X-Organizer-Id: {{org}}
Content-Type: application/json

{"zone_id": {{zoneId}}, "name": "Plein tarif", "price_mad": 5000, "quota": 100}

> {% client.global.set("priceId", response.body.id); %}

### 5b. Organizer: publish (DRAFT -> ON_SALE)
POST {{base}}/org/events/{{eventId}}/publish
Authorization: Bearer {{orgToken}}
X-Organizer-Id: {{org}}

### 6. Fan: ask for a code (backend log, put it in @fanCode)
POST {{base}}/fan/auth/otp
Content-Type: application/json

{"phone": "{{fanPhone}}"}

### 7. Fan: verify (creates the fan account on first login)
POST {{base}}/fan/auth/verify
Content-Type: application/json

{"phone": "{{fanPhone}}", "code": "{{fanCode}}"}

> {% client.global.set("fanToken", response.body.token); %}

### 7b. Fan: profile name (prefills holder row 1 in the clients)
PATCH {{base}}/fan/me
Authorization: Bearer {{fanToken}}
Content-Type: application/json

{"display_name": "Yazid Aqel"}

### 8. Fan: order two named places (held 8 min); the 2nd goes to the friend's phone (account created if new)
POST {{base}}/fan/orders
Authorization: Bearer {{fanToken}}
Content-Type: application/json

{"event_id": {{eventId}}, "channel": "WEB", "items": [{"price_category_id": "{{priceId}}", "qty": 2,
  "holders": [{"name": "Yazid Aqel"}, {"name": "Samir Benali", "phone": "{{friendPhone}}"}]}]}

> {% client.global.set("orderId", response.body.id); %}

### 9. Fan: pay by card. Open redirect_url in a browser and click "Approuver": /return then 302s to
#    payments.return-url.web (dev: http://localhost:3000/orders/{order_id}; APP orders: jomhor-fan://orders/{order_id}).
POST {{base}}/fan/orders/{{orderId}}/pay
Authorization: Bearer {{fanToken}}
Content-Type: application/json

{"method": "CARD"}

> {% client.global.set("redirectUrl", response.body.redirect_url); %}

### 10. Fan: poll until status = PAID and ticket_ids has two ids (items[0].holders: "Yazid A.", "Samir B.")
GET {{base}}/fan/orders/{{orderId}}
Authorization: Bearer {{fanToken}}

### 11. Organizer: the sale shows as sold = 2 (also on B2 Tarifs)
GET {{base}}/org/events/{{eventId}}/prices
Authorization: Bearer {{orgToken}}
X-Organizer-Id: {{org}}

### 12. Fan: my tickets (keeps the first ticket id; the friend's ticket is not listed to the buyer)
GET {{base}}/fan/tickets
Authorization: Bearer {{fanToken}}

> {% client.global.set("ticketId", response.body.tickets[0].id); %}

### 13. Fan: re-send the ticket PDF on WhatsApp -> 202 (holder only, VALID only). The job (every 10 s) logs
#    [dev WhatsApp] ticket XXXX XXXX -> +212*******11 (... bytes PDF)
#    A 4th re-send of one ticket within 24 h -> 429 DELIVERY_RATE_LIMITED (the automatic send after payment is not counted).
POST {{base}}/fan/tickets/{{ticketId}}/whatsapp
Authorization: Bearer {{fanToken}}
