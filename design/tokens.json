{
  "$schema": "design tokens, flat, consumed by Flutter ThemeData and Tailwind config",
  "brand": {
    "name": "Jomhor",
    "wordmark": "Jomhor",
    "arabic": "جمهور",
    "tagline_fr": "Jomhor. Le 12e homme.",
    "tagline_ar": "جمهور. الرجل الثاني عشر."
  },
  "club": { "name": "ATLAS FC", "shortName": "ATLAS", "crestInitial": "A", "crest": null },
  "color": {
    "ground": "#0B0F1A",
    "surface": "#141A2B",
    "surface2": "#1A2030",
    "border": "#2A3247",
    "borderMuted": "#4A5370",
    "text": "#FFFFFF",
    "textSecondary": "#C7CDDB",
    "textMuted": "#9AA3B8",
    "textDisabled": "#6B7488",
    "accent": "#F5B700",
    "accentHover": "#FFD24D",
    "onAccent": "#0B0F1A",
    "success": "#2E6B3F",
    "successBg": "#16331F",
    "successText": "#9FD4AE",
    "scanOk": "#0F6B3A",
    "scanReject": "#9B1C1C",
    "scanWarn": "#B8860B",
    "scanOverride": "#1D4ED8",
    "danger": "#F5A3A3",
    "zoneA": "#F5B700",
    "zoneB": "#3A86FF",
    "zoneC": "#B07CFF",
    "zoneDisabled": "#4A5370",
    "ticketPaper": "#FFFFFF",
    "ticketInk": "#0B0F1A",
    "ticketMuted": "#6B7488",
    "ticketRule": "#D6DAE3"
  },
  "font": {
    "display": "Barlow Condensed",
    "displayWeights": [600, 700, 800],
    "body": "Inter",
    "bodyWeights": [400, 500, 600],
    "arabicDisplay": "Cairo",
    "arabicBody": "IBM Plex Sans Arabic"
  },
  "type": {
    "hero": { "font": "display", "size": 44, "weight": 800, "lineHeight": 0.95, "transform": "uppercase" },
    "scanResult": { "font": "display", "size": 72, "weight": 800, "lineHeight": 1 },
    "h1": { "font": "display", "size": 28, "weight": 800, "lineHeight": 1 },
    "h2": { "font": "display", "size": 22, "weight": 700, "lineHeight": 1.1 },
    "number": { "font": "display", "size": 26, "weight": 800, "lineHeight": 1 },
    "body": { "font": "body", "size": 15, "weight": 500 },
    "bodySmall": { "font": "body", "size": 13, "weight": 400 },
    "cta": { "font": "body", "size": 16, "weight": 600 },
    "label": { "font": "body", "size": 12, "weight": 600, "letterSpacing": 1.5, "transform": "uppercase" },
    "caption": { "font": "body", "size": 11, "weight": 500 }
  },
  "radius": { "card": 24, "cardLarge": 28, "control": 16, "chip": 12, "pill": 999 },
  "space": { "xs": 4, "s": 8, "m": 12, "l": 16, "xl": 20, "xxl": 24 },
  "size": { "touchMin": 44, "ctaHeight": 54, "navHeight": 84, "phoneWidth": 390, "phoneHeight": 844, "navIcon": 22 },
  "motion": {
    "tapScale": 0.97,
    "fast": 120,
    "base": 220,
    "ticketFlip": 420,
    "qrRotationSeconds": 30,
    "greenAutoClearMs": 1500
  }
}
